# ──────────────────────────────────────────────────────────────────────────
# Root .env for `docker compose -f docker-compose.prod.yml`.
# Copy to .env and fill in every value marked required. Keep it chmod 600.
# The API reads the same variables; see apps/api/.env.example for details.
# ──────────────────────────────────────────────────────────────────────────

# Public hostname Caddy should obtain a TLS certificate for (DNS must point here).
DOMAIN=leads.example.com

# Postgres (compose creates the database with this password) ─ required
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://hothotleads:<same-as-POSTGRES_PASSWORD>@postgres:5432/hothotleads
DATABASE_SSL=false
DB_AUTO_MIGRATE=true

# Secrets ─ required
# Claude ─ pick ONE: an Anthropic key (A) or Amazon Bedrock via the instance role (B).
ANTHROPIC_API_KEY=sk-ant-...
# ── Option B: Claude via Amazon Bedrock (no Anthropic key). Needs AWS credentials in the
# default chain (EC2 instance role, env vars or a profile) with bedrock:InvokeModel*.
# Model ids must then be Bedrock cross-region inference profiles.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# CLAUDE_MODEL=us.anthropic.claude-sonnet-4-6
# CLAUDE_MODEL_HEAVY=us.anthropic.claude-sonnet-4-6
# CLAUDE_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-4-6
# ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-sonnet-4-6
APP_SECRET_KEY=
# First boot only: creates the platform admin who sets up organizations in /platform.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Origin used in invite / password-reset links (defaults to https://$DOMAIN).
# APP_PUBLIC_URL=https://leads.example.com

# Models (optional overrides)
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_HEAVY=claude-opus-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Web research
EXA_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# Channels (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Feature flags
SCHEDULES_ENABLED=false

LOG_LEVEL=info
