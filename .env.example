# ──────────────────────────────────────────────────────────────────────────
# Root .env for `docker compose -f docker-compose.prod.yml`.
# Copy to .env and fill in every value marked required. Keep it chmod 600.
# The API reads the same variables; see apps/api/.env.example for details.
# ──────────────────────────────────────────────────────────────────────────

# Public hostname Caddy should obtain a TLS certificate for (DNS must point here).
DOMAIN=leads.example.com

# Postgres (compose creates the database with this password) ─ required
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://hothotleads:<same-as-POSTGRES_PASSWORD>@postgres:5432/hothotleads
DATABASE_SSL=false
DB_AUTO_MIGRATE=true

# Secrets ─ required
ANTHROPIC_API_KEY=sk-ant-...
APP_AUTH_PASSWORD=
APP_SECRET_KEY=

# Models (optional overrides)
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_HEAVY=claude-opus-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Web research
EXA_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# Channels (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Feature flags
SCHEDULES_ENABLED=false

LOG_LEVEL=info
