# ──────────────────────────────────────────────────────────────────────────
# HotHotLeads API configuration. Copy to apps/api/.env for local dev, or to
# the repo root .env when running with docker compose.
# "required" vars make the API refuse to boot when missing.
# ──────────────────────────────────────────────────────────────────────────

# Claude ─ pick ONE of the two options.
# ── Option A: Anthropic API key. The Claude Agent SDK subprocess reads it from the environment.
ANTHROPIC_API_KEY=sk-ant-...
# ── Option B: Claude via Amazon Bedrock (no Anthropic key). Needs AWS credentials in the
# default chain (EC2 instance role, env vars or a profile) with bedrock:InvokeModel*.
# Model ids must then be Bedrock cross-region inference profiles.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# CLAUDE_MODEL=us.anthropic.claude-sonnet-4-6
# CLAUDE_MODEL_HEAVY=us.anthropic.claude-sonnet-4-6
# CLAUDE_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-4-6
# ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-sonnet-4-6
# Optional model overrides (defaults in apps/api/src/config/models.ts).
# Current-generation ids: claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5.
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_HEAVY=claude-opus-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Platform admin ─ required on first boot (while the users table is empty). Creates or
# promotes this account; the password is applied only if the account has none yet.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=

# Origin of the web app, used to build invite and password-reset links.
# Defaults to https://$DOMAIN when DOMAIN is set, else http://localhost:5173.
APP_PUBLIC_URL=http://localhost:5173

# App secret ─ required, min 32 chars. Encrypts channel credentials at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
APP_SECRET_KEY=

# Database (Postgres) ─ required
DATABASE_URL=postgresql://hothotleads:hothotleads@localhost:5434/hothotleads
DATABASE_SSL=false
# Only set to false for self-signed certs in dev; keep true against RDS/managed Postgres.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Apply pending migrations on boot (set false if you migrate in a release step).
DB_AUTO_MIGRATE=true
MIKROORM_DEBUG=false

# Web research ─ EXA_API_KEY is needed for prospect discovery, enrichment and signals.
EXA_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# Telegram (optional). TELEGRAM_WEBHOOK_SECRET must match the secret_token passed to setWebhook;
# inbound webhooks are rejected while it is empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp via Meta Cloud API (optional). WHATSAPP_APP_SECRET is the Meta app secret used to
# verify X-Hub-Signature-256; inbound webhooks are rejected while it is empty.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Feature flags
# Schedules are not production-ready (single-instance in-process cron). Off by default.
SCHEDULES_ENABLED=false

# Server
HOST=0.0.0.0
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
