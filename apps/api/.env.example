# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_HEAVY=claude-opus-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_SECRET=...

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_ACCESS_TOKEN=...
WHATSAPP_VERIFY_TOKEN=...

# Database (Postgres) — required
DATABASE_URL=postgresql://hothotleads:hothotleads@localhost:5434/hothotleads
DATABASE_SSL=false
MIKROORM_DEBUG=false

# App secret — used to encrypt channel credentials at rest (AES-256-GCM).
# Must be at least 32 chars. Generate with: openssl rand -hex 32
APP_SECRET_KEY=...

# Exa
EXA_API_KEY=...

# Server
HOST=0.0.0.0
PORT=3000
PUBLIC_URL=https://your-domain.com

# Logging
LOG_LEVEL=info
NODE_ENV=development
