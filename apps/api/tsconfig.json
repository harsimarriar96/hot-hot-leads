{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@hothotleads/config/tsconfig/nest.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@agents/*": ["src/agents/*"],
      "@channels/*": ["src/channels/*"],
      "@integrations/*": ["src/integrations/*"],
      "@common/*": ["src/common/*"],
      "@config/*": ["src/config/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
